{
  "name": "scrcpy-webrtc",
  "version": "0.6.0",
  "description": "View and control WiFi-connected Android devices from a browser. Self-hosted scrcpy over WebRTC P2P built on ya-webadb: video, audio, clipboard sync and an optional device shell.",
  "type": "module",
  "bin": {
    "scrcpy-webrtc": "server.mjs"
  },
  "files": [
    "server.mjs",
    "webrtc.mjs",
    "signal.mjs",
    "public/",
    "server.bin",
    "scrcpy-server.LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs'); fs.readdirSync('public').filter(f=>f.endsWith('.js')).forEach(f=>fs.rmSync('public/'+f))\"",
    "build": "esbuild src/client.js --bundle --format=esm --outfile=public/app.js --minify --loader:.css=text",
    "fetch-server": "fetch-scrcpy-server 3.1",
    "prepack": "npm run build && cp node_modules/@yume-chan/fetch-scrcpy-server/server.bin server.bin && cp node_modules/@yume-chan/fetch-scrcpy-server/scrcpy.LICENSE scrcpy-server.LICENSE",
    "start": "node server.mjs"
  },
  "keywords": [
    "scrcpy",
    "android",
    "screen-mirroring",
    "adb",
    "ya-webadb",
    "webcodecs"
  ],
  "author": "weishu <twsxtd@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tiann/scrcpy-webrtc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiann/scrcpy-webrtc.git"
  },
  "bugs": {
    "url": "https://github.com/tiann/scrcpy-webrtc/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@csl/ui": "^0.1.31",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@yume-chan/adb": "^2.6.2",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "^2.5.2",
    "@yume-chan/fetch-scrcpy-server": "^1.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/stream-extra": "^2.6.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "werift": "^0.24.3",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@trimjs/web-app": "^0.5.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "esbuild": "^0.28.1"
  }
}
